# ===================================================
# WILD TOUR KARNATAKA - BACKEND ENVIRONMENT VARIABLES
# ===================================================

# Server Port (Render automatically supplies PORT)
PORT=5000

# MongoDB Database Connection String (MongoDB Atlas in production)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/wildtour_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/wildtour_db

# JWT Encryption Secret (A secure random string, minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_encryption_key_2026

# Node Environment ('development' or 'production')
NODE_ENV=development

# Frontend Base URL (used in CORS & email verification links)
# In production on Render: https://<your-frontend-name>.onrender.com
# For multiple domains: https://your-site.onrender.com,https://yourcustomdomain.com
FRONTEND_URL=http://localhost:5173

# ===================================================
# EMAIL SMTP CONFIGURATION (Nodemailer)
# ===================================================
# For standard SMTP (e.g. Gmail App Password, Brevo, Sendgrid, Mailgun):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="Wild Tour Karnataka" <noreply@wildtour.com>

# ===================================================
# GOOGLE OAUTH 2.0 CREDENTIALS
# ===================================================
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Add your production Render frontend URL to Authorized Javascript Origins & Redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
