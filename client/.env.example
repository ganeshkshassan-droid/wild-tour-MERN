# ===================================================
# WILD TOUR KARNATAKA - FRONTEND ENVIRONMENT VARIABLES
# ===================================================

# Backend API Base URL
# In local development: http://localhost:5000/api
# In production on Render: https://<your-backend-name>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID (Web Application)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Javascript Origins: http://localhost:5173, https://<your-frontend-name>.onrender.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
